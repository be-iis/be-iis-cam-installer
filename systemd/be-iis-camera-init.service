[Unit]
Description=Initialize BE-IIS-GMSL-CAM2 MAX96716A/MAX96717 IMX708 camera
After=systemd-modules-load.service
ConditionPathExists=/dev/i2c-11

[Service]
Type=oneshot
# Configure both PoC links for 400 mA OCP with automatic release before power-up.
ExecStartPre=/usr/libexec/be-iis-camera/ina226-init-alerts.sh
ExecStart=/usr/libexec/be-iis-camera/init.sh init
# Log voltage and current for both links after camera initialization.
ExecStartPost=/usr/libexec/be-iis-camera/dump.sh both
ExecReload=/usr/libexec/be-iis-camera/init.sh init
RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
